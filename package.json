{
  "name": "atlas-scene-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atlas Scene Studio — a comfy, touch-friendly WebGL scene builder for desktop and iPad.",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "vite": "^8.3.8"
  }
}
